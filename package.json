{
  "name": "ttrpg-hearth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=db/seed.sql",
    "db:reset:local": "rm -rf .wrangler/state && npm run db:migrate:local && npm run db:seed:local",
    "deploy": "astro build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "backup": "wrangler d1 export DB --remote --output=backup-$(date +%F).sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.4",
    "astro": "^7.4.5",
    "marked": "^18.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  }
}
