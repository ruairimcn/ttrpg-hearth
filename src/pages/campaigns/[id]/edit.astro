---
import Layout from '../../../layouts/Layout.astro';
import CampaignForm from '../../../components/CampaignForm.astro';
import { first, run, str, oneOf, CAMPAIGN_STATUSES, NOW } from '../../../lib/db';
import { parseMoney } from '../../../lib/money';
const id = Number(Astro.params.id);
const c = await first<any>('SELECT * FROM campaigns WHERE id=?', id);
if (!c) return new Response('Not found', { status: 404 });
let error = '';
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const act = str(f, 'action');
  if (act === 'archive') { await run(`UPDATE campaigns SET archived_at=${NOW}, updated_at=${NOW} WHERE id=?`, id); return Astro.redirect('/campaigns'); }
  if (act === 'unarchive') { await run(`UPDATE campaigns SET archived_at=NULL, updated_at=${NOW} WHERE id=?`, id); return Astro.redirect(`/campaigns/${id}`); }
  if (act === 'delete') {
    const used = await first<any>(`SELECT (SELECT COUNT(*) FROM sessions WHERE campaign_id=?1)+(SELECT COUNT(*) FROM characters WHERE campaign_id=?1)+(SELECT COUNT(*) FROM payments WHERE campaign_id=?1) AS n`, id);
    if (used!.n > 0) error = 'Cannot delete: it has sessions, characters or payments. Archive it instead.';
    else { await run('DELETE FROM campaigns WHERE id=?', id); return Astro.redirect('/campaigns'); }
  } else {
    const price = parseMoney(str(f, 'price') || '0');
    if (!str(f, 'name')) error = 'Name is required.';
    else if (price === null) error = 'Price must be like 15 or 15.50.';
    else {
      await run(`UPDATE campaigns SET name=?,system=?,status=?,description=?,schedule_note=?,is_paid=?,default_session_price_cents=?,updated_at=${NOW} WHERE id=?`,
        str(f, 'name'), str(f, 'system') || 'D&D 5e', oneOf(str(f, 'status'), CAMPAIGN_STATUSES, 'planned'),
        str(f, 'description'), str(f, 'schedule_note'), str(f, 'is_paid') === '1' ? 1 : 0, price, id);
      return Astro.redirect(`/campaigns/${id}`);
    }
  }
}
---
<Layout title={`Edit ${c.name}`} active="campaigns">
  <h1>Edit campaign</h1>
  {error && <p class="err">{error}</p>}
  <form method="post"><CampaignForm c={c} /><div class="actions"><button class="primary">Save</button><a class="btn" href={`/campaigns/${id}`}>Cancel</a></div></form>
  <h2>Danger zone</h2>
  <form method="post" class="actions">
    {c.archived_at
      ? <button name="action" value="unarchive">Restore</button>
      : <button name="action" value="archive">Archive</button>}
    <button class="danger" name="action" value="delete" onclick="return confirm('Permanently delete this campaign? Only possible if it is empty.')">Delete (mistakes only)</button>
  </form>
</Layout>
